APP_NAME=Reusable RAG Assistant
APP_DESCRIPTION=Ask questions using the indexed knowledge base.

DOCS_DIR=data/multy_docs
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=rag_documents

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

MONGODB_URI=
MONGODB_DATABASE=rag_engine
MONGODB_COLLECTION=chat_history
MONGODB_FEEDBACK_COLLECTION=feedback

ADMIN_PASSWORD=

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=reusable-rag-engine

CHUNK_SIZE=700
CHUNK_OVERLAP=120

VECTOR_TOP_K=12
BM25_TOP_K=12
HYBRID_TOP_K=16
RERANK_TOP_K=12
FINAL_TOP_K=8

RRF_K=60
VECTOR_WEIGHT=0.55
BM25_WEIGHT=0.45

RELEVANCE_THRESHOLD=0.1
MIN_RERANK_SCORE=0.5

MULTI_QUERY_COUNT=2
QUERY_EXPANSION_ENABLED=true

EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

MAX_HISTORY_MESSAGES=4
MAX_QUESTION_LENGTH=1000
MAX_REQUESTS_PER_MINUTE=5
